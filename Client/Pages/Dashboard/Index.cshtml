@page
@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<div class="container py-4">
    <h2 class="mb-4">Dashboard</h2>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Tổng đơn</h6>
                    <div class="h3 mb-0" id="kpi-orders">—</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Doanh thu</h6>
                    <div class="h3 mb-0" id="kpi-revenue">—</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Sản phẩm</h6>
                    <div class="h3 mb-0" id="kpi-products">—</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Khách hàng</h6>
                    <div class="h3 mb-0" id="kpi-customers">—</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header d-flex align-items-center">
            <strong>Đơn gần đây</strong>
            <a class="btn btn-sm btn-outline-secondary ms-auto" href="/Orders">Xem tất cả</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Khách</th>
                        <th>Ngày</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @* TODO: bind dữ liệu trong .cshtml.cs *@
                    <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có dữ liệu</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
