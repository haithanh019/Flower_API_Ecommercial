@page
@{
    ViewData["Title"] = "Users";
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<div class="container py-4">
    <div class="d-flex align-items-center mb-3">
        <h2 class="mb-0">Users</h2>
        <a class="btn btn-primary ms-auto" href="/Users/Create">+ Thêm user</a>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input name="q" class="form-control" placeholder="Tìm theo tên / email / phone..." />
        </div>
        <div class="col-md-3">
            <select name="role" class="form-select">
                <option value="">— Tất cả vai trò —</option>
                <option value="0">Customer</option>
                <option value="1">Staff</option>
                <option value="2">Admin</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-secondary">Lọc</button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @* TODO: bind list user *@
                    <tr>
                        <td>—</td>
                        <td>—</td>
                        <td>—</td>
                        <td>—</td>
                        <td><span class="badge bg-secondary">—</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="/Users/Details?id=1">Xem</a>
                            <a class="btn btn-sm btn-outline-primary" href="/Users/Edit?id=1">Sửa</a>
                            <a class="btn btn-sm btn-outline-danger" href="/Users/Delete?id=1">Xoá</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card-footer">
            <nav aria-label="pagination">
                <ul class="pagination mb-0">
                    <li class="page-item disabled"><span class="page-link">Prev</span></li>
                    <li class="page-item active"><span class="page-link">1</span></li>
                    <li class="page-item"><a class="page-link" href="?page=2">2</a></li>
                    <li class="page-item"><a class="page-link" href="?page=2">Next</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>
