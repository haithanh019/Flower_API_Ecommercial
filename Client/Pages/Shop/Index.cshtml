@page
@model Client.Pages.Shop.IndexModel
@{
    ViewData["Title"] = "Shop";
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<div class="container py-4">
    <div class="d-flex align-items-center mb-3">
        <h2 class="mb-0">Cửa hàng</h2>
        <form method="get" class="ms-auto d-flex gap-2">
            <input name="q" value="@Model.Q" class="form-control" placeholder="Tìm sản phẩm..." />
            <select name="categoryId" class="form-select" style="max-width:220px">
                <option value="" selected="@(Model.CategoryId is null)">— Tất cả danh mục —</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
            <button class="btn btn-primary">Lọc</button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="row g-3">
        @foreach (var p in Model.Items)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <img src="@(!string.IsNullOrEmpty(p.ImageUrl) ? p.ImageUrl : "/img/no-image.png")" class="card-img-top" style="height:180px;object-fit:cover" alt="@p.ProductName" />
                    <div class="card-body d-flex flex-column">
                        <div class="small text-muted">@Model.CategoryName(p.CategoryId)</div>
                        <h6 class="card-title mt-1 mb-2">@p.ProductName</h6>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <strong>@p.Price.ToString("#,0") ₫</strong>
                            <a class="btn btn-sm btn-outline-secondary"
                               href="/Cart?handler=Add&productId=@p.ProductId&qty=1">Thêm vào giỏ</a>

                            <a class="btn btn-sm btn-outline-primary" href="/Shop/Details?id=@p.ProductId">Xem</a>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (Model.Items.Count == 0)
        {
            <div class="col-12 text-center text-muted py-5">Không có sản phẩm.</div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" href="?q=@Model.Q&categoryId=@Model.CategoryId&pg=@(Model.PageIndex - 1)&pageSize=@Model.PageSize">Prev</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" href="?q=@Model.Q&categoryId=@Model.CategoryId&pg=@i&pageSize=@Model.PageSize">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?q=@Model.Q&categoryId=@Model.CategoryId&pg=@(Model.PageIndex + 1)&pageSize=@Model.PageSize">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
