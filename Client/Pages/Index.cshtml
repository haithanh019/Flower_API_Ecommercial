@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["FullWidth"] = true;   // Cho hero phủ toàn màn hình
}

@section Banner {
    <!-- Hero full width -->
    <section class="hero-flower">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 text-center text-lg-start">
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2">🌸 Bloom sale: -10% đơn đầu tiên</span>
                    <h1 class="display-5 mt-3 mb-2 fw-bold">Gửi hoa – Gửi điều tốt đẹp</h1>
                    <p class="lead text-secondary mb-4">Bó hoa tươi trong ngày, thiệp viết tay và giao nhanh tại Đà Nẵng.</p>
                    <a class="btn btn-rose btn-lg me-2" href="/Products">Mua ngay</a>
                    <a class="btn btn-outline-rose btn-lg" href="/Occasions">Chọn theo dịp</a>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="hero-figure rounded-4 shadow-sm">
                        <img src="/images/flowers/logo-flower.svg" alt="Bouquet" class="img-fluid rounded-4" />
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<section class="container my-4">
    <!-- Danh mục nhanh -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-outline-rose btn-sm" href="/Occasions/SinhNhat">Sinh nhật</a>
        <a class="btn btn-outline-rose btn-sm" href="/Occasions/TinhYeu">Tình yêu</a>
        <a class="btn btn-outline-rose btn-sm" href="/Occasions/ChucMung">Chúc mừng</a>
        <a class="btn btn-outline-rose btn-sm" href="/Occasions/TotNghiep">Tốt nghiệp</a>
    </div>

    <div class="d-flex justify-content-between align-items-end mb-2">
        <h2 class="h4 m-0">Sản phẩm nổi bật</h2>
        <a class="link-flower small" href="/Products">Xem tất cả →</a>
    </div>

    <!-- Lưới sản phẩm -->
    <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4">
        @foreach (var p in Model.Products)
        {
            <div class="col">
                <div class="card product-card h-100 rounded-4 shadow-sm">
                    <div class="position-relative">
                        <div class="ratio ratio-4x3 rounded-top-4 overflow-hidden">
                            <img src="@p.Image" class="w-100 h-100 object-fit-cover" alt="@p.Name"
                                 onerror="this.style.display='none'; this.parentElement.classList.add('ph');" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.Badge))
                        {
                            <span class="badge text-bg-light position-absolute top-0 start-0 m-2">@p.Badge</span>
                        }
                    </div>
                    <div class="card-body">
                        <h3 class="h6 card-title mb-2">@p.Name</h3>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-rose fw-semibold">@p.Price.ToString("N0") ₫</div>
                            <div class="small">
                                @Html.Raw(new string('★', p.Rating))
                                <span class="text-muted">@Html.Raw(new string('☆', 5 - p.Rating))</span>
                            </div>
                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <a class="btn btn-outline-rose btn-sm" href="/Product/@p.Id">Xem chi tiết</a>
                            <button class="btn btn-rose btn-sm add-to-cart" data-id="@p.Id">Thêm vào giỏ</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
