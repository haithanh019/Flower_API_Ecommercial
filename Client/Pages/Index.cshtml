@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ - Flower Shop";
    ViewData["FullWidth"] = true;
}

@section Banner {
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="container">
                <div class="row align-items-center min-vh-75">
                    <div class="col-lg-6 col-md-8 hero-text">
                        <div class="hero-badge">
                            <span class="badge-icon">🌸</span>
                            <span>Bloom Sale: Giảm 10% đơn hàng đầu tiên</span>
                        </div>
                        <h1 class="hero-title">
                            Gửi Hoa -
                            <span class="text-gradient">Gửi Điều Tốt Đẹp</span>
                        </h1>
                        <p class="hero-subtitle">
                            Bó hoa tươi trong ngày, thiệp viết tay và giao hàng nhanh chóng tại Đà Nẵng.
                            Mang niềm vui và sự ấm áp đến người thân yêu của bạn.
                        </p>
                        <div class="hero-buttons">
                            <a href="/Shop" class="btn btn-primary btn-lg">
                                <i class="fas fa-shopping-bag me-2"></i>
                                Mua Ngay
                            </a>
                            <a href="#categories" class="btn btn-outline-light btn-lg">
                                <i class="fas fa-heart me-2"></i>
                                Chọn Theo Dịp
                            </a>
                        </div>
                        <div class="hero-stats">
                            <div class="stat-item">
                                <span class="stat-number">@Model.TotalCustomers+</span>
                                <span class="stat-label">Khách hàng hài lòng</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number">@Model.TotalProducts+</span>
                                <span class="stat-label">Loại hoa tươi</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number">@Model.DeliveryTime</span>
                                <span class="stat-label">Giao hàng nhanh</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 hero-image">
                        <div class="hero-image-container">
                            <div class="floating-element floating-1">🌺</div>
                            <div class="floating-element floating-2">🌸</div>
                            <div class="floating-element floating-3">🌻</div>
                            <img src="/images/flowers/hero-bouquet.jpg" alt="Beautiful flower bouquet" class="hero-main-image"
                                 onerror="this.src='/images/flowers/placeholder.jpg';" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<main class="homepage-content">
    <!-- Categories Section -->
    <section id="categories" class="categories-section py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">Hoa Theo Dịp</h2>
                <p class="section-subtitle">Chọn bó hoa phù hợp cho từng dịp đặc biệt</p>
            </div>
            <div class="row g-4">
                @foreach (var category in Model.GetCategories())
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="category-card" data-category="@category.Slug">
                            <div class="category-icon">@category.Icon</div>
                            <h4>@category.Name</h4>
                            <p>@category.Description</p>
                            <a href="/Shop?category=@category.Slug" class="btn btn-outline-primary">Xem Ngay</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Featured Products Section -->
    <section class="featured-products py-5 bg-light">
        <div class="container">
            <div class="row align-items-center mb-5">
                <div class="col">
                    <h2 class="section-title mb-0">Sản Phẩm Nổi Bật</h2>
                    <p class="section-subtitle mt-2">Những bó hoa được yêu thích nhất</p>
                </div>
                <div class="col-auto">
                    <a href="/Shop" class="btn btn-primary">
                        Xem Tất Cả
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    @Model.ErrorMessage
                </div>
            }

            <div class="row g-4">
                @if (Model.Products.Any())
                {
                    @foreach (var product in Model.Products.Take(6))
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="product-card h-100">
                                <div class="product-image">
                                    <img src="@Model.GetProductImage(product)"
                                         alt="@product.ProductName"
                                         class="card-img-top"
                                         onerror="this.src='/images/flowers/placeholder.jpg';" />

                                    @{
                                        var badge = Model.GetProductBadge(product);
                                    }
                                    @if (!string.IsNullOrEmpty(badge))
                                    {
                                        <span class="product-badge badge-@badge.ToLower().Replace(" ", "-")">@badge</span>
                                    }

                                    <div class="product-overlay">
                                        <a href="/Shop/Details/@product.ProductId" class="btn btn-white btn-sm">
                                            <i class="fas fa-eye me-1"></i>
                                            Xem Chi Tiết
                                        </a>
                                        <button class="btn btn-primary btn-sm add-to-cart" data-product-id="@product.ProductId">
                                            <i class="fas fa-shopping-cart me-1"></i>
                                            Thêm Vào Giỏ
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">@product.ProductName</h5>
                                    <div class="product-rating mb-2">
                                        @{
                                            var rating = Model.GetProductRating(product);
                                        }
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="fas fa-star @(i <= rating ? "text-warning" : "text-muted")"></i>
                                        }
                                        <span class="rating-text ms-1">(@rating.0)</span>
                                    </div>
                                    <div class="product-price">
                                        <span class="price-current">@Model.FormatPrice(Model.GetDisplayPrice(product))</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center py-5">
                            <i class="fas fa-seedling fa-3x text-muted mb-3"></i>
                            <h4>Chưa có sản phẩm</h4>
                            <p class="text-muted">Chúng tôi đang cập nhật các sản phẩm mới. Vui lòng quay lại sau!</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">Vì Sao Chọn Chúng Tôi?</h2>
                <p class="section-subtitle">Cam kết mang đến trải nghiệm tốt nhất cho khách hàng</p>
            </div>
            <div class="row g-4">
                @foreach (var feature in Model.GetFeatures())
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="feature-card text-center">
                            <div class="feature-icon">
                                <i class="@feature.Icon"></i>
                            </div>
                            <h4>@feature.Title</h4>
                            <p>@feature.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-section py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">Khách Hàng Nói Gì?</h2>
                <p class="section-subtitle">Những phản hồi chân thực từ khách hàng của chúng tôi</p>
            </div>
            <div class="row g-4">
                @foreach (var testimonial in Model.GetTestimonials())
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="testimonial-card">
                            <div class="testimonial-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star @(i <= testimonial.Rating ? "text-warning" : "text-muted")"></i>
                                }
                            </div>
                            <p class="testimonial-text">"@testimonial.Text"</p>
                            <div class="testimonial-author">
                                <img src="@testimonial.Avatar" alt="@testimonial.Name" class="author-avatar"
                                     onerror="this.src='/images/avatars/default.jpg';" />
                                <div class="author-info">
                                    <h6>@testimonial.Name</h6>
                                    <span>@testimonial.Location</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section py-5">
        <div class="container">
            <div class="cta-card text-center">
                <div class="cta-icon">🌹</div>
                <h3>Bắt Đầu Gửi Gắm Yêu Thương</h3>
                <p>Hãy để chúng tôi giúp bạn truyền tải những thông điệp yêu thương qua từng bông hoa</p>
                <div class="cta-buttons">
                    <a href="/Shop" class="btn btn-primary btn-lg me-3">
                        <i class="fas fa-shopping-bag me-2"></i>
                        Mua Hoa Ngay
                    </a>
                    <a href="/Account/Login" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-user-plus me-2"></i>
                        Đăng Nhập
                    </a>
                </div>
            </div>
        </div>
    </section>
</main>

@section Styles {
    <link href="~/css/pages/home.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/home.js"></script>

    <!-- Add Request Verification Token for AJAX calls -->
    <input name="__RequestVerificationToken" type="hidden" value="@Html.AntiForgeryToken()" />

    <script>
        // Update cart counter on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Update cart counter if user is logged in
            @if (User?.Identity?.IsAuthenticated == true || HttpContext.Session.GetInt32("UserId") != null)
            {
                    <text>
                    fetch('/Cart?handler=Count')
                        .then(response => response.json())
                        .then(data => {
                            if (data.ok) {
                                const counter = document.querySelector('.cart-counter');
                                if (counter) {
                                    counter.textContent = data.count;
                                    counter.style.display = data.count > 0 ? 'inline' : 'none';
                                }
                            }
                        })
                        .catch(error => console.error('Error loading cart count:', error));
                    </text>
            }
        });
    </script>
}