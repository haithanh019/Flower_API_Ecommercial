@page
@{
    ViewData["Title"] = "Orders";
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<div class="container py-4">
    <h2 class="mb-3">Orders</h2>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-3">
            <input name="q" class="form-control" placeholder="Tìm theo khách / mã đơn..." />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">— Tất cả trạng thái —</option>
                <option value="0">Pending</option>
                <option value="1">Confirmed</option>
                <option value="2">Preparing</option>
                <option value="3">Shipped</option>
                <option value="4">Delivered</option>
                <option value="5">Cancelled</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-secondary">Lọc</button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Khách</th>
                        <th>Ngày</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Tổng</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @* TODO: bind list đơn hàng *@
                    <tr>
                        <td>—</td>
                        <td>—</td>
                        <td>—</td>
                        <td>—</td>
                        <td><span class="badge bg-secondary">—</span></td>
                        <td class="text-end">—</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="/Orders/Details?id=1">Xem</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card-footer">
            <nav aria-label="pagination">
                <ul class="pagination mb-0">
                    <li class="page-item disabled"><span class="page-link">Prev</span></li>
                    <li class="page-item active"><span class="page-link">1</span></li>
                    <li class="page-item"><a class="page-link" href="?page=2">2</a></li>
                    <li class="page-item"><a class="page-link" href="?page=3">3</a></li>
                    <li class="page-item"><a class="page-link" href="?page=2">Next</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>
